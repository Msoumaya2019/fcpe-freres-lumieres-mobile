# =============================================================================
#  .env.example — modèle de configuration. Ce fichier est PUBLIC.
# =============================================================================
#
#  Utilisation
#  -----------
#    1. Copier ce fichier en `.env.local` (ignoré par Git, voir .gitignore).
#    2. Renseigner les deux valeurs Supabase ci-dessous.
#    3. Relancer `npm start` — Expo n'injecte les variables qu'au démarrage.
#
#  Où trouver les valeurs : tableau de bord Supabase > Project Settings >
#  API Keys. Prendre l'URL du projet et la clé « publishable » (anciennement
#  « anon public »).
#
# -----------------------------------------------------------------------------
#  RAPPEL CRITIQUE — à lire avant d'ajouter une variable
# -----------------------------------------------------------------------------
#  Toute variable préfixée `EXPO_PUBLIC_` est INJECTÉE EN CLAIR dans le bundle
#  livré aux utilisateurs : n'importe qui peut l'extraire d'un APK ou d'un IPA.
#
#  Ce n'est pas un problème pour la clé publishable : elle est conçue pour être
#  publique. Ce qui protège réellement les données, ce sont les politiques
#  Row Level Security définies dans `supabase/migrations/`.
#
#  En revanche, JAMAIS derrière un préfixe `EXPO_PUBLIC_` :
#    - la clé `service_role` / `sb_secret_...` — elle CONTOURNE TOUTES les
#      politiques RLS. La placer ici reviendrait à publier la base entière en
#      lecture et en écriture ;
#    - un jeton Expo (EXPO_TOKEN), un mot de passe de base de données, un
#      certificat de signature (.p12, .jks, .mobileprovision) ;
#    - toute donnée personnelle d'un adhérent.
#  `src/config/env.ts` refuse de démarrer si la clé fournie est une clé
#  service_role : c'est une garde, pas une autorisation de la mettre ici.
#
# -----------------------------------------------------------------------------
#  1. APPLICATION MOBILE — `.env.local` (développement local uniquement)
# -----------------------------------------------------------------------------

# URL du projet Supabase, de la forme https://<reference>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Clé publishable (ex-« anon public »). Publique par conception : la sécurité
# repose sur les politiques RLS, pas sur le secret de cette valeur.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Environnement logique : development | preview | production
EXPO_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
#  2. EAS BUILD — variables d'environnement côté serveur Expo
#     Les fichiers `.env.local` ne sont PAS téléversés vers EAS Build (ils sont
#     ignorés par Git, et EAS respecte `.gitignore`). Les valeurs doivent donc
#     être enregistrées sur EAS, une fois par environnement :
#
#       eas env:set --environment production \
#         --name EXPO_PUBLIC_SUPABASE_URL --value "https://xxxx.supabase.co" \
#         --visibility plaintext
#
#       eas env:set --environment production \
#         --name EXPO_PUBLIC_SUPABASE_ANON_KEY --value "sb_publishable_..." \
#         --visibility sensitive
#
#     `eas.json` associe chaque profil de build à un environnement
#     (`environment: development | preview | production`).
#     La clé publishable est marquée `sensitive` par principe : elle finit de
#     toute façon en clair dans le bundle, mais rien ne justifie de l'afficher
#     dans les journaux de build.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
#  3. INTÉGRATION CONTINUE — GitHub Actions Secrets
#     Settings > Secrets and variables > Actions. Jamais dans un fichier du
#     dépôt, même en `.example`.
# -----------------------------------------------------------------------------
# EXPO_TOKEN                 : jeton d'accès Expo (compte > Access tokens),
#                              requis par `.github/workflows/eas-build.yml`.
#                              Secret. À révoquer immédiatement s'il fuite.
# SUPABASE_ACCESS_TOKEN      : jeton d'API Supabase (Account > Access Tokens),
#                              requis uniquement si l'on déploie les migrations
#                              depuis la CI. Secret.
# SUPABASE_DB_PASSWORD       : mot de passe de la base, pour `supabase db push`.
#                              Secret.

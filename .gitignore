# =============================================================================
#  .gitignore — dépôt PUBLIC : aucune valeur réelle ne doit y entrer.
# =============================================================================

# Dépendances
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# CLI Supabase : cache local (version, branches), pas le schéma
supabase/.temp/
supabase/.branches/

# Dossiers natifs générés (EAS Build les régénère depuis app.json + les plugins)
/ios
/android

# -----------------------------------------------------------------------------
#  SECRETS — la raison d'être de ce fichier
# -----------------------------------------------------------------------------
# On ignore TOUS les fichiers d'environnement, puis on ré-autorise le modèle.
# Un `.env` oublié dans un dépôt public est la fuite la plus banale et la plus
# coûteuse ; l'exception explicite ci-dessous évite d'avoir à y penser.
.env
.env.*
!.env.example

# Clés et certificats de signature — jamais dans Git, jamais dans un build local
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.orig.*

# Jetons et identifiants d'outillage
.npmrc.local

# La clef de compte de service Firebase, celle qui sert a FCM v1 : c'est un
# SECRET, et elle ne doit jamais entrer dans le depot. Google la nomme
# « <projet>-firebase-adminsdk-<hash>.json » ; ce motif est le seul qui la
# reconnaisse, et il est ecrit pour ca.
*firebase-adminsdk*.json

# `google-services.json` n'est PAS ignore, et c'est deliberé : EAS ne televerse
# que ce que Git ne retient pas, donc l'ignorer priverait la compilation du
# fichier dont elle a besoin. Il ne porte que des identifiants publics —
# identifiant de projet, numero de projet, identifiant d'application, et une
# clef d'API restreinte au paquet et a l'empreinte de signature. La
# documentation d'Expo l'etablit, ce n'est pas une supposition. La ligne
# « google-services.json » figurait ici jusqu'au 20 septembre 2026 ; elle a ete
# retiree le jour ou la compilation a eu besoin du fichier.
GoogleService-Info.plist

# Journaux
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# Outils
.DS_Store
Thumbs.db
*.tsbuildinfo
coverage/
.workbuddy-ai/
